+// Offscreen export of the app's actual view components with its existing mock disk.
+private struct NativeMarketingExport: View {
+    let container: AppContainer
+    let scene: String
+    private var destination: Destination { switch scene {
+        case "junk": .group(.systemJunk)
+        case "developer": .group(.developer)
+        case "apps": .group(.applications)
+        default: .smartScan
+    }}
+    var body: some View {
+        ZStack {
+            NightSky()
+            HStack(spacing:0) {
+                Sidebar(session:container.session,destination:.constant(destination),showPlans:{})
+                Rectangle().fill(Palette.cardStroke).frame(width:1)
+                Group {
+                    if case let .group(group) = destination { GroupScreen(group:group,session:container.session,access:container.access) }
+                    else { SmartScanScreen(session:container.session) {_ in} }
+                }.frame(maxWidth:.infinity,maxHeight:.infinity)
+            }
+        }.frame(width:1280,height:800)
+    }
+}
