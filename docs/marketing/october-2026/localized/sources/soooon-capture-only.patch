@@ -0,0 +1,40 @@
+#if os(macOS)
+import AppKit
+import SwiftUI
+import Foundation
+import DesignSystem
+
+/// Capture-only host for the actual macOS product views. The desktop is never captured.
+@MainActor
+enum NativeMarketingMacExport {
+ static func runIfAsked() {
+  guard ProcessInfo.processInfo.arguments.contains("-native-export") else { return }
+  Task { @MainActor in
+   guard let path = UserDefaults.standard.string(forKey:"marketingOut") else { exit(2) }
+   let directory=URL(fileURLWithPath:path).deletingLastPathComponent().appending(path:".fixture")
+   try? FileManager.default.createDirectory(at:directory,withIntermediateDirectories:true)
+   let container=AppContainer(stack:SharedStack(directory:directory),clock:DemoClock.clock())
+   await DemoSeed.fillIfEmpty(container)
+   let root=LaunchRoot(container:container)
+    .frame(maxWidth:.infinity,maxHeight:.infinity)
+    .background(Palette.background)
+    .environment(\.locale,Locale(identifier:UserDefaults.standard.string(forKey:"AppleLocale") ?? "en_US"))
+    .environment(\.layoutDirection,["ar","he","ur"].contains(UserDefaults.standard.stringArray(forKey:"AppleLanguages")?.first ?? "") ? .rightToLeft : .leftToRight)
+    .environment(\.photoFolder,container.photoFolder)
+    .environment(\.colorScheme,.light)
+   let host=NSHostingView(rootView:root)
+   let window=NSWindow(contentRect:NSRect(x:0,y:0,width:1500,height:1000),styleMask:[.borderless],backing:.buffered,defer:false)
+   window.contentView=host
+   host.frame=NSRect(x:0,y:0,width:1500,height:1000)
+   host.layoutSubtreeIfNeeded();window.displayIfNeeded()
+   try? await Task.sleep(for:.milliseconds(2500))
+   host.layoutSubtreeIfNeeded();window.displayIfNeeded()
+   let rep=NSBitmapImageRep(bitmapDataPlanes:nil,pixelsWide:3000,pixelsHigh:2000,bitsPerSample:8,samplesPerPixel:4,hasAlpha:true,isPlanar:false,colorSpaceName:.deviceRGB,bytesPerRow:0,bitsPerPixel:0)!
+   rep.size=CGSize(width:1500,height:1000)
+   host.cacheDisplay(in:host.bounds,to:rep)
+   if let data=rep.representation(using:.png,properties:[:]){try?data.write(to:URL(fileURLWithPath:path))}
+   print("NATIVE EXPORT READY");fflush(stdout);exit(0)
+  }
+ }
+}
+#endif
