+/// Isolated screenshot route: production screens, local sample store only.
+private struct MarketingCaptureRoot: View {
+    let container: AppContainer
+    private var scene: String {
+        let args = ProcessInfo.processInfo.arguments
+        return args.firstIndex(of: "-marketing-screen").flatMap { $0 + 1 < args.count ? args[$0 + 1] : nil } ?? "home"
+    }
+    @ViewBuilder var body: some View {
+        switch scene {
+        case "detail": NavigationStack { CountdownDetailScreen(viewModel: container.detailViewModel(for: CountdownID(string: "5EED0000-0000-0000-0000-000000000001")!), container: container) }
+        case "calendar": NavigationStack { CalendarEventsScreen(calendar: container.calendarEventsViewModel(), sounds: container.sounds) }
+        case "personality": OnboardingScreen(viewModel: personality(), sounds: container.sounds, finished: {})
+        case "holidays": NavigationStack { DiscoverScreen(viewModel: container.discoverViewModel(), calendar: container.calendarEventsViewModel(), celebrations: container.celebrationsViewModel(), sounds: container.sounds) }
+        case "wardrobe": NavigationStack { WardrobeScreen(wardrobe: container.wardrobe, outfit: nil, sounds: container.sounds) }
+        default:
+            #if os(macOS)
+            HomeScreen(viewModel: container.homeViewModel(), container: container)
+            #else
+            RootView(container: container)
+            #endif
+        }
+    }
+    private func personality() -> OnboardingViewModel {
+        let vm = container.onboardingViewModel()
+        vm.jump(to: .personality)
+        return vm
+    }
+}
