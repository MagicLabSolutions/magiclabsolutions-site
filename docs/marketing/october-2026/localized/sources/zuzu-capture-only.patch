     override func viewDidAppear(_ animated: Bool) {
         super.viewDidAppear(animated)
         hasAppeared = true
+        if !marketingDidRender, ProcessInfo.processInfo.arguments.contains("-marketing-screen") {
+            marketingDidRender = true
+            DispatchQueue.main.asyncAfter(deadline: .now() + 2) { self.marketingCaptureScene() }
+        }
         if let pending = pendingDeeplink {
             pendingDeeplink = nil
             handlePresentationDeeplink(pending)
         }
+    }
+
+    /// Capture-only scene routing on the existing local screenshot fixture.
+    private var marketingDidRender = false
+    private func marketingCaptureScene() {
+        let args = ProcessInfo.processInfo.arguments
+        let scene = args.firstIndex(of: "-marketing-screen").flatMap { $0 + 1 < args.count ? args[$0 + 1] : nil } ?? "hero"
+        switch scene {
+        case "hero", "timeline":
+            viewModel.selectedTab = .timeline
+            if scene == "timeline" {
+                DispatchQueue.main.asyncAfter(deadline: .now() + 2) { self.marketingScroll(self.selectedViewController?.view, offset: 520) }
+            }
+        case "insights": viewModel.selectedTab = .insights
+        case "growth":
+            let profile = BabyProfileViewController()
+            profile.baby = ScreenshotFixture.baby
+            profile.homeViewModel = sharedHomeViewModel
+            (selectedViewController as? UINavigationController)?.pushViewController(profile, animated: false)
+            if UIDevice.current.userInterfaceIdiom != .pad {
+                DispatchQueue.main.asyncAfter(deadline: .now() + 2) { self.marketingScroll(profile.view, offset: 420) }
+            }
+        case "nap": sharedHomeViewModel.startNap(at: Date().addingTimeInterval(-18 * 60))
+        default: break
+        }
+        print("[MarketingCapture] scene ready: \(scene)")
+    }
+    private func marketingScroll(_ view: UIView?, offset: CGFloat) {
+        guard let view else { return }
+        if let scroll = view as? UIScrollView, scroll.bounds.height > 300,
+            scroll.contentSize.height > scroll.bounds.height + offset {
+            scroll.setContentOffset(CGPoint(x: 0, y: offset), animated: false)
+            return
+        }
+        for child in view.subviews { marketingScroll(child, offset: offset) }
     }
 
