+import SwiftUI
+import SwiftData
+import UIKit
+
+/// Lightweight wrappers around the real app screens, each of which
+/// pulls the right piece of seeded state out of the in-memory model
+/// container before mounting the screen the screenshot wants to show.
+///
+/// Each host:
+///   - opens its own `@Query` against the model container,
+///   - picks the active demo project (Léo by default),
+///   - mounts the production screen at the precise initial state we
+///     want captured — no nav clicks, no waiting for animations, no
+///     fragile UI scripting.
+///
+/// If a screen needs a state that the seed alone can't produce (e.g.
+/// the soundtrack picker open inside the tool sheet), the host
+/// constructs that state directly with the same APIs the app uses, so
+/// the captured frame is still the *real* view, not a screenshot
+/// stand-in.
+
+// MARK: - Project home
+
+struct ProjectHomeScreenshotHost: View {
+    @Query(sort: \Project.createdAt, order: .forward) private var projects: [Project]
+
+    var body: some View {
+        NavigationStack {
+            if let project = activeProject {
+                ProjectHomeView(project: project)
+            } else {
+                placeholder
+            }
+        }
+    }
+
+    private var activeProject: Project? {
+        // Prefer the explicitly-active project (the seed sets Léo); fall
+        // back to the first one in case the seeded state isn't ready
+        // yet on first render.
+        if let activeID = ProjectManager.shared.activeProjectID,
+           let project = projects.first(where: { $0.id == activeID }) {
+            return project
+        }
+        return projects.first
+    }
+
+    private var placeholder: some View {
+        ZStack { AppColor.background.ignoresSafeArea() }
+    }
+}
+
+// MARK: - Memory list (highlights)
+
+struct MemoryListScreenshotHost: View {
+    @Query(sort: \Project.createdAt, order: .forward) private var projects: [Project]
+
+    var body: some View {
+        NavigationStack {
+            if let project = projects.first {
+                // Open the list with the highlights filter applied so the
+                // screen leads with starred memories — that's what the
+                // marketing line ("Star the moments that matter") promises.
+                MemoryListView(
+                    project: project,
+                    initialFilter: .builtin(.highlights)
+                )
+                // The offscreen renderer paints the inline nav title
+                // white and drops the toolbar buttons on the iOS 27
+                // runtime (the pinned light scheme no longer helps), so
+                // the bar is left out — the "Highlights" chip already
+                // names the screen.
+                .toolbar(.hidden, for: .navigationBar)
+            } else {
+                ZStack { AppColor.background.ignoresSafeArea() }
+            }
+        }
+    }
+}
+
+// MARK: - Compilation preview
+
+struct CompilationScreenshotHost: View {
+    @Query(sort: \Project.createdAt, order: .forward) private var projects: [Project]
+    @Environment(\.modelContext) private var modelContext
+
+    var body: some View {
+        if let project = projects.first {
+            // Pick the most recent month of the active project — most
+            // populated with memories, makes the "9 photos · 0 videos"
+            // line on the film card render with real numbers instead
+            // of zeros.
+            let period = PersonalPeriod.current(
+                projectID: project.id,
+                referenceDate: project.referenceDate
+            )
+            // Inject a fake `Compilation` row into the project so
+            // `CompilationView` lands on its `.completed` ready state
+            // rather than the empty "Build this month's film?" CTA.
+            // The compilation's `localFileName` points at a file that
+            // doesn't exist — that's intentional. `CompilationView`
+            // detects screenshot mode and renders a static poster
+            // image (the first memory's thumbnail) instead of trying
+            // to wire `AVPlayer` to the missing file.
+            CompilationView(project: project, period: period)
+                .id("\(project.id.uuidString)-\(period.monthIndex)")
+                .onAppear {
+                    Self.ensureCompilation(
+                        for: project,
+                        period: period,
+                        context: modelContext
+                    )
+                }
+        } else {
+            ZStack { AppColor.background.ignoresSafeArea() }
+        }
+    }
+
+    @MainActor
+    private static func ensureCompilation(
+        for project: Project,
+        period: PersonalPeriod,
+        context: ModelContext
+    ) {
+        // Don't double-insert if a previous render already added one.
+        let existing = (project.compilations ?? []).first { c in
+            c.periodStart == period.startDate && c.periodEnd == period.endDate
+        }
+        if existing != nil { return }
+
+        let compilation = Compilation(
+            type: .monthly,
+            periodStart: period.startDate,
+            periodEnd: period.endDate,
+            aspectRatio: .portrait_9_16,
+            audioChoice: .silent
+        )
+        // `localFileName` set to a stable string so the view enters its
+        // ready state. The actual `.mp4` doesn't exist; the screenshot
+        // poster fallback in `CompilationView.playerSurface` handles
+        // the "video missing" case explicitly for screenshot mode.
+        compilation.localFileName = "screenshot-poster.mp4"
+        compilation.memoryCount = (project.memories ?? [])
+            .filter { period.contains($0.capturedAt) && $0.deletedAt == nil }
+            .count
+        compilation.durationSeconds = 28
+        context.insert(compilation)
+        project.compilations?.append(compilation)
+    }
+}
+
+// MARK: - Soundtrack picker
+
+/// The CompilationToolSheet is normally surfaced as a `.sheet` from
+/// inside `CompilationView`. For the screenshot we render it directly
+/// (no sheet wrapper) so the canvas is the picker itself.
+struct CompilationToolSheetScreenshotHost: View {
+    let activeTool: CompilationTool
+
+    @Query(sort: \Project.createdAt, order: .forward) private var projects: [Project]
+    @State private var aspect: AspectRatio = .portrait_9_16
+    @State private var audio: AudioChoice = .random
+    @State private var muted: Bool = false
+    @State private var filter: CompilationFilter = .none
+    @State private var titleText: String = ""
+    @State private var titleSubtitle: String = ""
+    @State private var titleStyle: CompilationTitleStyle = .none
+    @State private var titleColorHex: String = CompilationTitle.defaultColorHex
+    @State private var titlePosition: CompilationTitlePosition = .center
+    @State private var titleSize: CompilationTitleSize = .medium
+    @State private var speed: CompilationSpeed = .normal
+    @State private var transition: CompilationTransition = .smooth
+
+    var body: some View {
+        if let project = projects.first {
+            let period = PersonalPeriod.current(
+                projectID: project.id,
+                referenceDate: project.referenceDate
+            )
+            // The first memory's media URL stands in for the filter-preview
+            // and title-preview backgrounds — same path the real sheet
+            // takes when it's launched from `CompilationView`.
+            let firstMedia: URL? = (project.memories ?? [])
+                .sorted { $0.capturedAt < $1.capturedAt }
+                .first
+                .map { FileStore.shared.mediaURL(projectID: project.id, fileName: $0.localFileName) }
+            CompilationToolSheet(
+                tool: activeTool,
+                aspectRatio: $aspect,
+                audioChoice: $audio,
+                mutesOriginalAudio: $muted,
+                filter: $filter,
+                filterPreviewURL: firstMedia,
+                titleText: $titleText,
+                titleSubtitle: $titleSubtitle,
+                titleStyle: $titleStyle,
+                titleColorHex: $titleColorHex,
+                titlePosition: $titlePosition,
+                titleSize: $titleSize,
+                titlePreviewBackgroundURL: firstMedia,
+                playbackSpeed: $speed,
+                compilationVideoURL: nil,
+                compilationBaseSpeed: 1.0,
+                transition: $transition,
+                isPlus: true,
+                onApply: {},
+                onLockedTap: {}
+            )
+            // Project context for `@Query`-based subviews.
+            .id(project.id)
+            // Period is unused here but suppresses unused-variable warnings.
+            .onAppear { _ = period }
+        } else {
+            ZStack { AppColor.background.ignoresSafeArea() }
+        }
+    }
+}
+
+// MARK: - Year-summary reveal
+
+struct CompilationRevealScreenshotHost: View {
+    @Query(sort: \Project.createdAt, order: .forward) private var projects: [Project]
+
+    var body: some View {
+        if let project = projects.first {
+            // The reveal view is normally driven by `RevealCenter` after
+            // a notification tap. We synthesise a `PendingReveal` for
+            // the most recent year of the project so the view renders
+            // its celebratory state without needing the notification
+            // pipeline to be live.
+            CompilationRevealView(reveal: Self.makePendingReveal(for: project))
+        } else {
+            ZStack { AppColor.background.ignoresSafeArea() }
+        }
+    }
+
+    private static func makePendingReveal(for project: Project) -> RevealCenter.PendingReveal {
+        let calendar = Calendar.current
+        let yearStart = project.referenceDate
+        let yearEnd = calendar.date(byAdding: .year, value: 1, to: yearStart) ?? yearStart
+        // Month index 11 marks the close of the first 12-month cycle —
+        // the trigger condition `AutoSuggestEngine` uses for year
+        // summaries, which is what this reveal wants to celebrate.
+        return RevealCenter.PendingReveal(
+            id: UUID(),
+            projectID: project.id,
+            monthIndex: 11,
+            periodStart: yearStart,
+            periodEnd: yearEnd,
+            isYear: true
+        )
+    }
+}
+
+// MARK: - Films list
+
+struct FilmsScreenshotHost: View {
+    @Query(sort: \Project.createdAt, order: .forward) private var projects: [Project]
+
+    var body: some View {
+        if let project = projects.first {
+            // The seed populates 12 monthly compilations on Léo's
+            // project, so `FilmsView` renders a populated grid of
+            // film thumbnails. Each compilation shows the procedural
+            // poster image inside its tile (same fallback as
+            // `CompilationView` uses).
+            NavigationStack {
+                FilmsView(project: project)
+            }
+        } else {
+            ZStack { AppColor.background.ignoresSafeArea() }
+        }
+    }
+}
+
+// MARK: - Project switcher
+
+struct ProjectSwitcherScreenshotHost: View {
+    var body: some View {
+        ProjectSwitcherSheet()
+    }
+}
+
+// MARK: - Paywall
+
+struct PaywallScreenshotHost: View {
+    var body: some View {
+        // The main paywall page; the screenshot copy is identical to the
+        // onboarding one.
+        PaywallView()
+    }
+}
+
+struct MarketingMacRoot: View {
+    @State private var scene = "home"
+    var body: some View {
+        Group {
+            switch scene {
+            case "film": CompilationScreenshotHost()
+            case "highlights": MemoryListScreenshotHost()
+            case "soundtrack": CompilationToolSheetScreenshotHost(activeTool: .soundtrack)
+            case "year": CompilationRevealScreenshotHost()
+            case "projects": ProjectSwitcherScreenshotHost()
+            default: ProjectHomeScreenshotHost()
+            }
+        }
+        .id(scene)
+        .environment(\.locale, Locale(identifier: UserDefaults.standard.string(forKey: "AppleLocale") ?? Locale.current.identifier))
+        .preferredColorScheme(.light)
+        .background(CatalystCaptureDriver(scene: $scene).frame(width: 0, height: 0))
+    }
+}
+private struct CatalystCaptureDriver: UIViewRepresentable {
+    // MARK: - Properties
+    @Binding var scene: String
+
+    // MARK: - Public Methods
+    /// Creates the native hook after the production view has entered its window.
+    func makeUIView(context: Context) -> UIView {
+        let view = UIView(frame: .zero)
+        context.coordinator.begin(view: view, scene: $scene)
+        return view
+    }
+
+    /// Keeps capture independent of SwiftUI's layout updates.
+    func updateUIView(_ uiView: UIView, context: Context) {}
+
+    /// Maintains the six-screen capture sequence.
+    func makeCoordinator() -> Coordinator { Coordinator() }
+
+    // MARK: - Coordinator
+    final class Coordinator {
+        // MARK: - Properties
+        private let scenes = ["home", "film", "highlights", "soundtrack", "year", "projects"]
+        private var index = 0
+
+        // MARK: - Public Methods
+        /// Runs only when explicit capture destination and screenshot-mode flags are supplied.
+        func begin(view: UIView, scene: Binding<String>) {
+            let args = CommandLine.arguments
+            guard args.contains("-marketing-screen"), let i = args.firstIndex(of: "-marketing-out"), i + 1 < args.count else { return }
+            let target = args[i + 1]
+            DispatchQueue.main.async {
+                if let window = view.window {
+                    window.bounds.size = CGSize(width: 1200, height: 776)
+                    window.rootViewController?.view.frame = window.bounds
+                }
+            }
+            DispatchQueue.main.asyncAfter(deadline: .now() + 3) { self.capture(view: view, scene: scene, target: target) }
+        }
+
+        // MARK: - Private Methods
+        /// Writes a 2x native UIKit/Catalyst capture and advances to the next real screen.
+        private func capture(view: UIView, scene: Binding<String>, target: String) {
+            guard let window = view.window, let root = window.rootViewController?.view else {
+                print("CAPTURE_ERROR no native window")
+                exit(2)
+            }
+            // Use a native layout canvas matching the original MacBook display.
+            window.bounds.size = CGSize(width: 1200, height: 776)
+            root.frame = window.bounds
+            root.layoutIfNeeded()
+            let format = UIGraphicsImageRendererFormat()
+            format.scale = 2
+            format.opaque = true
+            let image = UIGraphicsImageRenderer(size: root.bounds.size, format: format).image { _ in
+                root.drawHierarchy(in: root.bounds, afterScreenUpdates: true)
+            }
+            let file = URL(fileURLWithPath: target).appendingPathComponent("native-\(index + 1).png")
+            do { try image.pngData()!.write(to: file) }
+            catch { print("CAPTURE_ERROR \(error)"); exit(3) }
+            print("CAPTURE \(scenes[index]) \(Int(image.size.width * image.scale))x\(Int(image.size.height * image.scale)) locale=\(Bundle.main.preferredLocalizations.joined(separator: ","))")
+            fflush(stdout)
+            index += 1
+            if index == scenes.count { exit(0) }
+            scene.wrappedValue = scenes[index]
+            DispatchQueue.main.asyncAfter(deadline: .now() + 1.8) { self.capture(view: view, scene: scene, target: target) }
+        }
+    }
+}
