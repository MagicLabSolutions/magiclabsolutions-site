+@MainActor enum MarketingCaptures {
+    // MARK: - View Builders
+
+    @MainActor
+    static func homeView() -> some View {
+        UserDefaultFlags.didDismissImportAnnouncementCard = true
+        let vm = HomeViewModel()
+        vm.isLoading = false
+        vm.subscriptions = MockData.allSubscriptions
+        vm.upcoming = MockData.allActive
+        vm.activeIncludingGrace = MockData.allActive
+        vm.upcomingRenewals = MockData.allActive
+        vm.cancelled = [MockData.disneyPlus]
+        vm.categoryTotals = MockData.categoryTotals
+        vm.currentMonthTotal = ["USD": 105.52]
+        vm.nextRenewalDays = 3
+        vm.nextRenewalsCount = 2
+        vm.currentMonthTitle = "October"
+        vm.top3Expensive = Array(MockData.allActive.prefix(5))
+        vm.top3Cheapest = Array(MockData.allActive.suffix(5))
+
+        return HomeContentView()
+            .environmentObject(vm)
+    }
+
+    @MainActor
+    static func plansView() -> some View {
+        let vm = PlansViewModel()
+        vm.isLoading = false
+        vm.upcoming = MockData.allActive
+        vm.cancelled = [MockData.disneyPlus]
+        vm.cancelledButActive = []
+
+        return PlansContentView()
+            .environmentObject(vm)
+    }
+
+    @MainActor
+    static func detailView() -> some View {
+        let vm = PlanDetailViewModel(subscription: MockData.netflix)
+
+        return PlanDetailContentView()
+            .environmentObject(vm)
+    }
+
+    /// The import entry screen. 1.2.5 shipped screenshot import as the headline feature
+    /// and the store listing never showed it once.
+    @MainActor
+    /// The review screen rather than the import entry screen: what sells this feature is
+    /// the result — a list the app found for you — not a screen with a button on it.
+    static func importView() -> some View {
+        ImportEmailReviewContentView()
+            .environmentObject(ImportEmailViewModel(preloadedResults: MockData.parsedSubscriptions))
+    }
+
+    /// Home scoped to "All Profiles" so the by-profile breakdown card is visible — that
+    /// card is the feature, not the switcher.
+    @MainActor
+    static func profilesView() -> some View {
+        UserDefaultFlags.didDismissImportAnnouncementCard = true
+        let vm = HomeViewModel()
+        vm.isLoading = false
+        vm.subscriptions = MockData.allSubscriptions
+        vm.upcoming = MockData.allActive
+        vm.activeIncludingGrace = MockData.allActive
+        vm.upcomingRenewals = MockData.allActive
+        vm.categoryTotals = MockData.categoryTotals
+        vm.currentMonthTotal = ["USD": 105.52]
+        vm.currentMonthTitle = "October"
+        vm.nextRenewalDays = 3
+        vm.nextRenewalsCount = 2
+        vm.profileTotals = MockData.profileTotals
+
+        return HomeContentView()
+            .environmentObject(vm)
+    }
+
+    @MainActor
+    static func renewalsView() -> some View {
+        let vm = RenewalsViewModel()
+        vm.isLoading = false
+        vm.hasSubscriptions = true
+        vm.groupedDays = [
+            (day: Date(), subscriptions: [MockData.netflix, MockData.spotify]),
+            (day: Date(timeIntervalSinceNow: 3 * 86400), subscriptions: [MockData.chatGPT]),
+            (day: Date(timeIntervalSinceNow: 7 * 86400), subscriptions: [MockData.iCloud]),
+            (day: Date(timeIntervalSinceNow: 14 * 86400), subscriptions: [MockData.youtube, MockData.gym]),
+        ]
+
+        return RenewalsContentView()
+            .environmentObject(vm)
+    }
+}
