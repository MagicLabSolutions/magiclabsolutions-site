+
+import SwiftUI
+import SwiftData
+
+
+/// Lightweight wrappers around the real app screens, each of which
+/// pulls the right piece of seeded state out of the in-memory model
+/// container before mounting the screen the screenshot wants to show.
+///
+/// Each host:
+///   - opens its own `@Query` against the model container,
+///   - picks the active demo project (Léo by default),
+///   - mounts the production screen at the precise initial state we
+///     want captured — no nav clicks, no waiting for animations, no
+///     fragile UI scripting.
+///
+/// If a screen needs a state that the seed alone can't produce (e.g.
+/// the soundtrack picker open inside the tool sheet), the host
+/// constructs that state directly with the same APIs the app uses, so
+/// the captured frame is still the *real* view, not a screenshot
+/// stand-in.
+
+// MARK: - Project home
+
+struct ProjectHomeScreenshotHost: View {
+    @Query(sort: \Project.createdAt, order: .forward) private var projects: [Project]
+
+    var body: some View {
+        NavigationStack {
+            if let project = activeProject {
+                ProjectHomeView(project: project)
+            } else {
+                placeholder
+            }
+        }
+    }
+
+    private var activeProject: Project? {
+        // Prefer the explicitly-active project (the seed sets Léo); fall
+        // back to the first one in case the seeded state isn't ready
+        // yet on first render.
+        if let activeID = ProjectManager.shared.activeProjectID,
+           let project = projects.first(where: { $0.id == activeID }) {
+            return project
+        }
+        return projects.first
+    }
+
+    private var placeholder: some View {
+        ZStack { AppColor.cream.ignoresSafeArea() }
+    }
+}
+
+// MARK: - Memory list (highlights)
+
+struct MemoryListScreenshotHost: View {
+    @Query(sort: \Project.createdAt, order: .forward) private var projects: [Project]
+
+    var body: some View {
+        NavigationStack {
+            if let project = projects.first {
+                // Open the list with the highlights filter applied so the
+                // screen leads with starred memories — that's what the
+                // marketing line ("Star the moments that matter") promises.
+                MemoryListView(
+                    project: project,
+                    initialFilter: .builtin(.highlights)
+                )
+            } else {
+                ZStack { AppColor.cream.ignoresSafeArea() }
+            }
+        }
+    }
+}
+
+// MARK: - Compilation preview
+
+struct CompilationScreenshotHost: View {
+    @State private var fixtureReady = false
+    @Query(sort: \Project.createdAt, order: .forward) private var projects: [Project]
+    @Environment(\.modelContext) private var modelContext
+
+    var body: some View {
+        if let project = projects.first {
+            // Pick the most recent month of the active project — most
+            // populated with memories, makes the "9 photos · 0 videos"
+            // line on the film card render with real numbers instead
+            // of zeros.
+            let period = PersonalPeriod.current(
+                projectID: project.id,
+                referenceDate: project.referenceDate
+            )
+            // Inject a fake `Compilation` row into the project so
+            // `CompilationView` lands on its `.completed` ready state
+            // rather than the empty "Build this month's film?" CTA.
+            // The compilation's `localFileName` points at a file that
+            // doesn't exist — that's intentional. `CompilationView`
+            // detects screenshot mode and renders a static poster
+            // image (the first memory's thumbnail) instead of trying
+            // to wire `AVPlayer` to the missing file.
+            Group {
+                if fixtureReady {
+                    CompilationView(project: project, period: period)
+                        .id("\(project.id.uuidString)-\(period.monthIndex)")
+                } else {
+                    Color.clear.task {
+                        Self.ensureCompilation(for: project, period: period, context: modelContext)
+                        try? modelContext.save()
+                        fixtureReady = true
+                    }
+                }
+            }
+        } else {
+            ZStack { AppColor.cream.ignoresSafeArea() }
+        }
+    }
+
+    @MainActor
+    private static func ensureCompilation(
+        for project: Project,
+        period: PersonalPeriod,
+        context: ModelContext
+    ) {
+        // Don't double-insert if a previous render already added one.
+        let existing = (project.compilations ?? []).first { c in
+            c.periodStart == period.startDate && c.periodEnd == period.endDate
+        }
+        if existing != nil { return }
+
+        let compilation = Compilation(
+            type: .monthly,
+            periodStart: period.startDate,
+            periodEnd: period.endDate,
+            aspectRatio: .portrait_9_16,
+            audioChoice: .silent
+        )
+        // `localFileName` set to a stable string so the view enters its
+        // ready state. The actual `.mp4` doesn't exist; the screenshot
+        // poster fallback in `CompilationView.playerSurface` handles
+        // the "video missing" case explicitly for screenshot mode.
+        compilation.localFileName = "screenshot-poster.mp4"
+        compilation.memoryCount = (project.memories ?? [])
+            .filter { period.contains($0.capturedAt) && $0.deletedAt == nil }
+            .count
+        compilation.durationSeconds = 28
+        context.insert(compilation)
+        project.compilations?.append(compilation)
+    }
+}
+
+// MARK: - Soundtrack picker
+
+/// The CompilationToolSheet is normally surfaced as a `.sheet` from
+/// inside `CompilationView`. For the screenshot we render it directly
+/// (no sheet wrapper) so the canvas is the picker itself.
+struct CompilationToolSheetScreenshotHost: View {
+    let activeTool: CompilationTool
+
+    @Query(sort: \Project.createdAt, order: .forward) private var projects: [Project]
+    @State private var aspect: AspectRatio = .portrait_9_16
+    @State private var audio: AudioChoice = .random
+    @State private var muted: Bool = false
+    @State private var filter: CompilationFilter = .none
+    @State private var titleText: String = ""
+    @State private var titleSubtitle: String = ""
+    @State private var titleStyle: CompilationTitleStyle = .none
+    @State private var titleColorHex: String = CompilationTitle.defaultColorHex
+    @State private var titlePosition: CompilationTitlePosition = .center
+    @State private var titleSize: CompilationTitleSize = .medium
+    @State private var speed: CompilationSpeed = .normal
+    @State private var transition: CompilationTransition = .smooth
+
+    var body: some View {
+        if let project = projects.first {
+            let period = PersonalPeriod.current(
+                projectID: project.id,
+                referenceDate: project.referenceDate
+            )
+            // The first memory's media URL stands in for the filter-preview
+            // and title-preview backgrounds — same path the real sheet
+            // takes when it's launched from `CompilationView`.
+            let firstMedia: URL? = (project.memories ?? [])
+                .sorted { $0.capturedAt < $1.capturedAt }
+                .first
+                .map { FileStore.shared.mediaURL(projectID: project.id, fileName: $0.localFileName) }
+            CompilationToolSheet(
+                tool: activeTool,
+                aspectRatio: $aspect,
+                audioChoice: $audio,
+                mutesOriginalAudio: $muted,
+                filter: $filter,
+                filterPreviewURL: firstMedia,
+                titleText: $titleText,
+                titleSubtitle: $titleSubtitle,
+                titleStyle: $titleStyle,
+                titleColorHex: $titleColorHex,
+                titlePosition: $titlePosition,
+                titleSize: $titleSize,
+                titlePreviewBackgroundURL: firstMedia,
+                playbackSpeed: $speed,
+                compilationVideoURL: nil,
+                compilationBaseSpeed: 1.0,
+                transition: $transition,
+                isPlus: true,
+                onApply: {},
+                onLockedTap: {}
+            )
+            // Project context for `@Query`-based subviews.
+            .id(project.id)
+            // Period is unused here but suppresses unused-variable warnings.
+            .onAppear { _ = period }
+        } else {
+            ZStack { AppColor.cream.ignoresSafeArea() }
+        }
+    }
+}
+
+
+struct MarketingCaptureView: View {
+    var body: some View {
+        let args = ProcessInfo.processInfo.arguments
+        let index = args.firstIndex(of: "-marketing-screen").flatMap { $0 + 1 < args.count ? args[$0 + 1] : nil } ?? "home"
+        Group {
+            switch index {
+            case "highlights": MemoryListScreenshotHost()
+            case "film": CompilationScreenshotHost()
+            case "soundtrack": CompilationToolSheetScreenshotHost(activeTool: .soundtrack)
+            default: ProjectHomeScreenshotHost()
+            }
+        }
+    }
+}
